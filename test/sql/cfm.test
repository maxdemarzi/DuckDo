# name: test/sql/cfm.test
# description: end-to-end causal foundation model inference (Do-PFN over ONNX)
# group: [duckdo]
#
# Skipped unless DUCKDO_MODEL_DIR points at a directory holding exported graphs:
#   python scripts/export/export_dopfn.py --repo <Do-PFN checkout> --out build/models
#   DUCKDO_MODEL_DIR=$(pwd)/build/models ./build/release/test/unittest "test/*"
# It also needs a build configured with -DDUCKDO_ONNXRUNTIME_ROOT.

require duckdo

require-env DUCKDO_MODEL_DIR

statement ok
SET duckdo_model_dir = '${DUCKDO_MODEL_DIR}';

statement ok
SET duckdo_query_chunk = 256;

statement ok
SELECT setseed(0.42);

# Confounded DGP, true ATE exactly 3.0, effect heterogeneous in x1.
statement ok
CREATE TABLE customers AS
WITH u AS (
  SELECT i,
         sqrt(-2*ln(random()+1e-12))*cos(2*pi()*random()) AS x1,
         sqrt(-2*ln(random()+1e-12))*cos(2*pi()*random()) AS x2,
         sqrt(-2*ln(random()+1e-12))*cos(2*pi()*random()) AS noise,
         random() AS draw
  FROM range(1500) t(i)
), p AS (SELECT *, 1.0/(1.0+exp(-(0.9*x1 - 0.6*x2))) AS ps FROM u)
SELECT i AS customer_id, x1, x2,
       (draw < ps)::INTEGER AS discount,
       2.0 + 1.5*x1 + 0.7*x2 + 3.0*((draw < ps)::INTEGER) + noise AS revenue
FROM p;

query I
SELECT bool_and(available) FROM do_list_models();
----
true

# The model recovers the effect. The tolerance is wider than the classical
# estimators' because Do-PFN shrinks population effects - a documented property
# of this model class, not a bug in the plumbing.
query I
SELECT abs(estimate - 3.0) < 0.6
FROM do_ate('customers', treatment := 'discount', outcome := 'revenue',
            exclude := ['customer_id'], model := 'do_pfn');
----
true

# The result names the model, not a classical estimator, and is honest about
# what its interval does and does not cover.
query II
SELECT estimator, variance_method FROM do_ate('customers', treatment := 'discount',
       outcome := 'revenue', exclude := ['customer_id'], model := 'do_pfn');
----
do_pfn	effect dispersion (no model uncertainty)

# The CC BY 4.0 attribution obligation travels with the result.
query I
SELECT list_contains(warnings, 'do_pfn is CC BY 4.0; attribution is required downstream')
FROM do_ate('customers', treatment := 'discount', outcome := 'revenue',
            exclude := ['customer_id'], model := 'do_pfn');
----
true

# One row per input row, and the learner column reports the model.
query II
SELECT count(*), any_value(learner)
FROM do_cate('customers', treatment := 'discount', outcome := 'revenue',
             exclude := ['customer_id'], model := 'do_pfn');
----
1500	do_pfn

# Ranking is the model's strength: per-row effects track the truth closely even
# where the population average is shrunk.
statement ok
CREATE TABLE het AS
WITH u AS (
  SELECT i,
         sqrt(-2*ln(random()+1e-12))*cos(2*pi()*random()) AS x1,
         sqrt(-2*ln(random()+1e-12))*cos(2*pi()*random()) AS x2,
         sqrt(-2*ln(random()+1e-12))*cos(2*pi()*random()) AS noise,
         random() AS draw
  FROM range(1500) t(i)
), p AS (SELECT *, 1.0/(1.0+exp(-(0.8*x1 - 0.5*x2))) AS ps FROM u)
SELECT i AS id, x1, x2, (draw < ps)::INTEGER AS t,
       2.0 + 1.5*x1 + 0.7*x2 + (3.0 + 2.0*x1)*((draw < ps)::INTEGER) + noise AS y
FROM p;

query I
SELECT corr(c.cate, 3.0 + 2.0*h.x1) > 0.9
FROM do_cate('het', treatment := 't', outcome := 'y', exclude := ['id'], id := 'id',
             model := 'do_pfn') c
JOIN het h ON h.id = c.id::BIGINT;
----
true

# --- CausalPFN ---------------------------------------------------------------
#
# CausalPFN targets the backdoor setting directly rather than hedging under a
# non-identifiable prior, and in these benchmarks it does not shrink: it lands
# where AIPW does. So its tolerance is the tight one.

query I
SELECT abs(estimate - 3.0) < 0.25
FROM do_ate('customers', treatment := 'discount', outcome := 'revenue',
            exclude := ['customer_id'], model := 'causalpfn');
----
true

query II
SELECT estimator, variance_method FROM do_ate('customers', treatment := 'discount',
       outcome := 'revenue', exclude := ['customer_id'], model := 'causalpfn');
----
causalpfn	effect dispersion (no model uncertainty)

# Apache-2.0 carries no attribution obligation, so no such warning is attached.
query I
SELECT NOT list_contains(warnings, 'causalpfn is Apache-2.0; attribution is required downstream')
FROM do_ate('customers', treatment := 'discount', outcome := 'revenue',
            exclude := ['customer_id'], model := 'causalpfn');
----
true

query I
SELECT corr(c.cate, 3.0 + 2.0*h.x1) > 0.95
FROM do_cate('het', treatment := 't', outcome := 'y', exclude := ['id'], id := 'id',
             model := 'causalpfn') c
JOIN het h ON h.id = c.id::BIGINT;
----
true

# The two models disagree in the documented direction: Do-PFN shrinks the
# population effect, CausalPFN does not. This asserts the finding, so a future
# change that silently alters it fails the suite.
query I
SELECT (SELECT estimate FROM do_ate('het', treatment := 't', outcome := 'y', exclude := ['id'],
                                    model := 'causalpfn'))
     > (SELECT estimate FROM do_ate('het', treatment := 't', outcome := 'y', exclude := ['id'],
                                    model := 'do_pfn'));
----
true

# --- context ensemble ---------------------------------------------------------
#
# One forward pass cannot see how much the answer depends on which rows landed in
# the model's context. Re-drawing the context and looking at the spread measures
# exactly that. On this DGP the single-draw interval is roughly 0.01 wide and
# excludes the truth; the ensemble interval is an order of magnitude wider and
# contains it. That is the whole point.

query I
SELECT variance_method LIKE 'context ensemble%'
FROM do_ate('customers', treatment := 'discount', outcome := 'revenue',
            exclude := ['customer_id'], model := 'causalpfn', ensemble := 6);
----
true

query I
SELECT (SELECT std_error FROM do_ate('customers', treatment := 'discount', outcome := 'revenue',
                                     exclude := ['customer_id'], model := 'causalpfn', ensemble := 6))
     > (SELECT std_error FROM do_ate('customers', treatment := 'discount', outcome := 'revenue',
                                     exclude := ['customer_id'], model := 'causalpfn'));
----
true

# The wider interval is the one that actually covers the truth.
query I
SELECT ci_low < 3.0 AND 3.0 < ci_high
FROM do_ate('customers', treatment := 'discount', outcome := 'revenue',
            exclude := ['customer_id'], model := 'causalpfn', ensemble := 6);
----
true

# A single draw still reports no per-row interval rather than a fabricated one.
query I
SELECT bool_and(cate_low = cate_high)
FROM do_cate('customers', treatment := 'discount', outcome := 'revenue',
             exclude := ['customer_id'], model := 'causalpfn');
----
true

query I
SELECT avg(cate_high - cate_low) > 0.05
FROM do_cate('customers', treatment := 'discount', outcome := 'revenue',
             exclude := ['customer_id'], model := 'causalpfn', ensemble := 6);
----
true

# The interval says what it does and does not cover.
query I
SELECT list_contains(warnings, '6 bootstrapped context draws; the interval covers context selection and sampling, not the model''s own parameter uncertainty')
FROM do_ate('customers', treatment := 'discount', outcome := 'revenue',
            exclude := ['customer_id'], model := 'causalpfn', ensemble := 6);
----
true
