# name: test/sql/cfm.test
# description: end-to-end causal foundation model inference (Do-PFN over ONNX)
# group: [sql]

#
# Skipped unless DUCKDO_MODEL_DIR points at a directory holding exported graphs:
#   python scripts/export/export_dopfn.py --repo <Do-PFN checkout> --out build/models
#   DUCKDO_MODEL_DIR=$(pwd)/build/models ./build/release/test/unittest "test/*"
# It also needs a build configured with -DDUCKDO_WITH_ONNX=ON.

require duckdo

require-env DUCKDO_MODEL_DIR

statement ok
SET duckdo_model_dir = '${DUCKDO_MODEL_DIR}';

statement ok
SET duckdo_query_chunk = 256;

statement ok
SELECT setseed(0.42);

# Confounded DGP, true ATE exactly 3.0, effect heterogeneous in x1.
statement ok
CREATE TABLE customers AS
WITH u AS (
  SELECT i,
         sqrt(-2*ln(random()+1e-12))*cos(2*pi()*random()) AS x1,
         sqrt(-2*ln(random()+1e-12))*cos(2*pi()*random()) AS x2,
         sqrt(-2*ln(random()+1e-12))*cos(2*pi()*random()) AS noise,
         random() AS draw
  FROM range(1500) t(i)
), p AS (SELECT *, 1.0/(1.0+exp(-(0.9*x1 - 0.6*x2))) AS ps FROM u)
SELECT i AS customer_id, x1, x2,
       (draw < ps)::INTEGER AS discount,
       2.0 + 1.5*x1 + 0.7*x2 + 3.0*((draw < ps)::INTEGER) + noise AS revenue
FROM p;

query I
SELECT bool_and(available) FROM do_list_models();
----
true

# The model recovers the effect. The tolerance is wider than the classical
# estimators' because Do-PFN shrinks population effects - a documented property
# of this model class, not a bug in the plumbing.
query I
SELECT abs(estimate - 3.0) < 0.6
FROM do_ate('customers', treatment := 'discount', outcome := 'revenue',
            exclude := ['customer_id'], model := 'do_pfn');
----
true

# The result names the model, not a classical estimator, and is honest about
# what its interval does and does not cover.
query II
SELECT estimator, variance_method FROM do_ate('customers', treatment := 'discount',
       outcome := 'revenue', exclude := ['customer_id'], model := 'do_pfn');
----
do_pfn	effect dispersion (no model uncertainty)

# That Do-PFN's upstream grants no licence travels with the result.
query I
SELECT len(list_filter(warnings, lambda w: w LIKE 'do_pfn''s upstream repository states no licence%')) = 1
FROM do_ate('customers', treatment := 'discount', outcome := 'revenue',
            exclude := ['customer_id'], model := 'do_pfn');
----
true

# One row per input row, and the learner column reports the model.
query II
SELECT count(*), any_value(learner)
FROM do_cate('customers', treatment := 'discount', outcome := 'revenue',
             exclude := ['customer_id'], model := 'do_pfn');
----
1500	do_pfn

# Ranking is the model's strength: per-row effects track the truth closely even
# where the population average is shrunk.
statement ok
CREATE TABLE het AS
WITH u AS (
  SELECT i,
         sqrt(-2*ln(random()+1e-12))*cos(2*pi()*random()) AS x1,
         sqrt(-2*ln(random()+1e-12))*cos(2*pi()*random()) AS x2,
         sqrt(-2*ln(random()+1e-12))*cos(2*pi()*random()) AS noise,
         random() AS draw
  FROM range(1500) t(i)
), p AS (SELECT *, 1.0/(1.0+exp(-(0.8*x1 - 0.5*x2))) AS ps FROM u)
SELECT i AS id, x1, x2, (draw < ps)::INTEGER AS t,
       2.0 + 1.5*x1 + 0.7*x2 + (3.0 + 2.0*x1)*((draw < ps)::INTEGER) + noise AS y
FROM p;

query I
SELECT corr(c.cate, 3.0 + 2.0*h.x1) > 0.9
FROM do_cate('het', treatment := 't', outcome := 'y', exclude := ['id'], id := 'id',
             model := 'do_pfn') c
JOIN het h ON h.id = c.id::BIGINT;
----
true

# --- CausalPFN ---------------------------------------------------------------
#
# CausalPFN targets the backdoor setting directly rather than hedging under a
# non-identifiable prior, and in these benchmarks it does not shrink: it lands
# where AIPW does. So its tolerance is the tight one.

query I
SELECT abs(estimate - 3.0) < 0.25
FROM do_ate('customers', treatment := 'discount', outcome := 'revenue',
            exclude := ['customer_id'], model := 'causalpfn');
----
true

query II
SELECT estimator, variance_method FROM do_ate('customers', treatment := 'discount',
       outcome := 'revenue', exclude := ['customer_id'], model := 'causalpfn');
----
causalpfn	effect dispersion (no model uncertainty)

# CausalPFN's licence puts no obligation on a result, so no licence warning is attached.
query I
SELECT len(list_filter(warnings, lambda w: w LIKE '%licen%')) = 0
FROM do_ate('customers', treatment := 'discount', outcome := 'revenue',
            exclude := ['customer_id'], model := 'causalpfn');
----
true

query I
SELECT corr(c.cate, 3.0 + 2.0*h.x1) > 0.95
FROM do_cate('het', treatment := 't', outcome := 'y', exclude := ['id'], id := 'id',
             model := 'causalpfn') c
JOIN het h ON h.id = c.id::BIGINT;
----
true

# The two models disagree in the documented direction: Do-PFN shrinks the
# population effect, CausalPFN does not. This asserts the finding, so a future
# change that silently alters it fails the suite.
query I
SELECT (SELECT estimate FROM do_ate('het', treatment := 't', outcome := 'y', exclude := ['id'],
                                    model := 'causalpfn'))
     > (SELECT estimate FROM do_ate('het', treatment := 't', outcome := 'y', exclude := ['id'],
                                    model := 'do_pfn'));
----
true

# --- context ensemble ---------------------------------------------------------
#
# One forward pass cannot see how much the answer depends on which rows landed in
# the model's context. Re-drawing the context and looking at the spread measures
# exactly that. On this DGP the single-draw interval is roughly 0.01 wide and
# excludes the truth; the ensemble interval is an order of magnitude wider and
# contains it. That is the whole point.

query I
SELECT variance_method LIKE 'context ensemble%'
FROM do_ate('customers', treatment := 'discount', outcome := 'revenue',
            exclude := ['customer_id'], model := 'causalpfn', ensemble := 6);
----
true

query I
SELECT (SELECT std_error FROM do_ate('customers', treatment := 'discount', outcome := 'revenue',
                                     exclude := ['customer_id'], model := 'causalpfn', ensemble := 6))
     > (SELECT std_error FROM do_ate('customers', treatment := 'discount', outcome := 'revenue',
                                     exclude := ['customer_id'], model := 'causalpfn'));
----
true

# The wider interval is the one that actually covers the truth.
query I
SELECT ci_low < 3.0 AND 3.0 < ci_high
FROM do_ate('customers', treatment := 'discount', outcome := 'revenue',
            exclude := ['customer_id'], model := 'causalpfn', ensemble := 6);
----
true

# A single draw still reports no per-row interval rather than a fabricated one.
query I
SELECT bool_and(cate_low = cate_high)
FROM do_cate('customers', treatment := 'discount', outcome := 'revenue',
             exclude := ['customer_id'], model := 'causalpfn');
----
true

query I
SELECT avg(cate_high - cate_low) > 0.05
FROM do_cate('customers', treatment := 'discount', outcome := 'revenue',
             exclude := ['customer_id'], model := 'causalpfn', ensemble := 6);
----
true

# The interval says what it does and does not cover.
query I
SELECT list_contains(warnings, '6 bootstrapped draws; the interval covers context selection and sampling, not the model''s own parameter uncertainty')
FROM do_ate('customers', treatment := 'discount', outcome := 'revenue',
            exclude := ['customer_id'], model := 'causalpfn', ensemble := 6);
----
true

# --- a covariate budget that binds -----------------------------------------------
#
# Twelve covariates that all contribute, against Do-PFN's budget of five. A
# single pass keeps the five most outcome-correlated and discards the other
# seven; an ensemble spreads that choice across draws instead, so the interval
# covers which covariates were picked rather than treating that as free.

statement ok
SELECT setseed(0.37);

statement ok
CREATE TABLE wide12 AS
WITH u AS (SELECT i,
    sqrt(-2*ln(random()+1e-12))*cos(2*pi()*random()) AS x1,
    sqrt(-2*ln(random()+1e-12))*cos(2*pi()*random()) AS x2,
    sqrt(-2*ln(random()+1e-12))*cos(2*pi()*random()) AS x3,
    sqrt(-2*ln(random()+1e-12))*cos(2*pi()*random()) AS x4,
    sqrt(-2*ln(random()+1e-12))*cos(2*pi()*random()) AS x5,
    sqrt(-2*ln(random()+1e-12))*cos(2*pi()*random()) AS x6,
    sqrt(-2*ln(random()+1e-12))*cos(2*pi()*random()) AS x7,
    sqrt(-2*ln(random()+1e-12))*cos(2*pi()*random()) AS x8,
    sqrt(-2*ln(random()+1e-12))*cos(2*pi()*random()) AS x9,
    sqrt(-2*ln(random()+1e-12))*cos(2*pi()*random()) AS x10,
    sqrt(-2*ln(random()+1e-12))*cos(2*pi()*random()) AS x11,
    sqrt(-2*ln(random()+1e-12))*cos(2*pi()*random()) AS x12,
    sqrt(-2*ln(random()+1e-12))*cos(2*pi()*random()) AS e,
    random() AS d
  FROM range(1200) r(i)),
 p AS (SELECT *, 1.0/(1.0+exp(-(0.85*x1 + 0.80*x2 + 0.75*x3 + 0.70*x4 + 0.65*x5 + 0.60*x6 + 0.55*x7 + 0.50*x8 + 0.45*x9 + 0.40*x10 + 0.35*x11 + 0.30*x12))) AS ps FROM u)
SELECT i AS cid, x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,
       (d<ps)::INT AS trt,
       2.0 + (0.85*x1 + 0.80*x2 + 0.75*x3 + 0.70*x4 + 0.65*x5 + 0.60*x6 + 0.55*x7 + 0.50*x8 + 0.45*x9 + 0.40*x10 + 0.35*x11 + 0.30*x12) + 3.0*((d<ps)::INT) + e AS rev
FROM p;

# The ensemble interval is far wider than the single-draw one, because varying
# the covariate subset exposes uncertainty a single top-k pass cannot see.
query I
SELECT (SELECT std_error FROM do_ate('wide12', treatment:='trt', outcome:='rev',
                                     exclude:=['cid'], model:='do_pfn', ensemble:=4))
     > 10 * (SELECT std_error FROM do_ate('wide12', treatment:='trt', outcome:='rev',
                                          exclude:=['cid'], model:='do_pfn'));
----
true

# But a wider interval is not a correct one. Dropping seven confounders is bias,
# and the result says so instead of letting the healthier-looking interval imply
# otherwise. A correctly specified AIPW restricted to the same five covariates
# returns 4.07 against a truth of 3.0, so most of the damage is the budget.
query I
SELECT len(list_filter(warnings, lambda w: w LIKE '%confounding bias, not sampling variance%')) = 1
FROM do_ate('wide12', treatment:='trt', outcome:='rev', exclude:=['cid'], model:='do_pfn', ensemble:=4);
----
true

query I
SELECT abs(estimate - 4.07) < 0.3
FROM do_ate('wide12', treatment:='trt', outcome:='rev', covariates:=['x1','x2','x3','x4','x5']);
----
true

# The model whose budget actually fits recovers it.
query I
SELECT abs(estimate - 3.0) < 0.2
FROM do_ate('wide12', treatment:='trt', outcome:='rev', exclude:=['cid'], model:='causalpfn');
----
true

# Where the budget does not bind, subset ensembling is a no-op: every draw gets
# every covariate, so no such warning appears.
query I
SELECT len(list_filter(warnings, lambda w: w LIKE '%different subset weighted by%')) = 0
FROM do_ate('wide12', treatment:='trt', outcome:='rev', exclude:=['cid'], model:='causalpfn', ensemble:=3);
----
true

# duckdo_query_chunk is a cost knob and nothing else. It decides how many rows go
# through one forward pass, and the context is re-encoded for each chunk - which
# is worth a factor of six in wall clock on eight thousand rows, and must be
# worth exactly nothing in the answer. Measured at 512 vs 8192 the estimate is
# bit-identical; this pins that, because a chunk size that leaked into the result
# would be a silent correctness bug rather than a slow query.
statement ok
SET duckdo_query_chunk = 128;

statement ok
CREATE TABLE chunk_a AS
SELECT estimate FROM do_ate('customers', treatment:='discount', outcome:='revenue',
                            exclude:=['customer_id'], model:='causalpfn');

statement ok
SET duckdo_query_chunk = 4096;

query I
SELECT (SELECT estimate FROM chunk_a) = estimate
FROM do_ate('customers', treatment:='discount', outcome:='revenue',
            exclude:=['customer_id'], model:='causalpfn');
----
true

statement ok
SET duckdo_query_chunk = 256;
