# name: test/sql/discover_rcd.test
# description: RCD names the hidden common cause that LiNGAM assumes away, invents none where there is none, and says so when it cannot tell
# group: [sql]

require duckdo

statement ok
SELECT setseed(0.9);

# a and c share a hidden cause, and b causes c. The hidden cause contributes as
# much to a and to c as their own noise does, so neither stands in for it.
statement ok
CREATE TABLE confounded AS
WITH u AS (
  SELECT (random() - 0.5) * 3.4641 AS lat,
         (random() - 0.5) * 3.4641 AS b,
         (random() - 0.5) * 3.4641 AS e1,
         (random() - 0.5) * 3.4641 AS e2
  FROM range(6000) t(i))
SELECT lat + e1 AS a, b, lat + 0.9*b + e2 AS c FROM u;

# LiNGAM assumes there is no hidden cause, so it has to explain the pair with a
# direct edge, and gets the rest of the graph wrong along the way.
query I
SELECT count(*) FROM do_discover('confounded', algorithm := 'lingam', bootstrap := 0)
WHERE in_graph AND edge = '->' AND source = 'b' AND target = 'a';
----
1

# FCI finds the skeleton but will not commit: a o-> c still allows a to cause c.
query I
SELECT string_agg(source || edge || target, ' ' ORDER BY source, target)
FROM do_discover('confounded', algorithm := 'fci', bootstrap := 0) WHERE in_graph;
----
ao->c bo->c

# RCD names it. Neither direction of a and c leaves an independent residual, so
# no model without a hidden common cause fits the pair; b -> c is unaffected.
query I
SELECT string_agg(source || edge || target, ' ' ORDER BY source, target)
FROM do_discover('confounded', algorithm := 'rcd', bootstrap := 0) WHERE in_graph;
----
a<->c b-->c

# The hidden cause reaches identification: <-> becomes a latent node in the
# proposal, which do_graph_create and do_identify already understand.
query II
SELECT n_bidirected, dot LIKE '%[latent]%'
FROM do_discover_dot('confounded', algorithm := 'rcd', bootstrap := 0);
----
1	true

# --- where there is nothing to find -----------------------------------------------

statement ok
SELECT setseed(0.77);

statement ok
CREATE TABLE clean AS
WITH u AS (
  SELECT (random() - 0.5) * 3.4641 AS a,
         (random() - 0.5) * 3.4641 AS b,
         (random() - 0.5) * 3.4641 AS e1,
         (random() - 0.5) * 3.4641 AS e2
  FROM range(6000) t(i))
SELECT a, b, 0.8*a + 0.8*b + 0.5*e1 AS c, 0.9*(0.8*a + 0.8*b + 0.5*e1) + 0.5*e2 AS d FROM u;

# No hidden cause anywhere, so it invents none - and orients every edge, which PC
# on the same world cannot. Over 40 simulated runs it invented 0.00 per run.
query I
SELECT string_agg(source || edge || target, ' ' ORDER BY source, target)
FROM do_discover('clean', algorithm := 'rcd', bootstrap := 0) WHERE in_graph;
----
a-->c b-->c c-->d

query I
SELECT count(*) FROM do_discover('clean', algorithm := 'rcd', bootstrap := 0)
WHERE in_graph AND edge = '<->';
----
0

# --- where it cannot tell ----------------------------------------------------------

statement ok
SELECT setseed(0.41);

statement ok
CREATE TABLE gaussian_world AS
WITH u AS (
  SELECT sqrt(-2*ln(random()+1e-12))*cos(2*pi()*random()) AS ex,
         sqrt(-2*ln(random()+1e-12))*cos(2*pi()*random()) AS ey,
         sqrt(-2*ln(random()+1e-12))*cos(2*pi()*random()) AS ez
  FROM range(6000) t(i))
SELECT ex AS x, 0.8*ex + ey AS y, 0.6*(0.8*ex + ey) + ez AS z FROM u;

# On Gaussian disturbances both directions leave an independent residual, so every
# pair comes back o-o. RCD needs no refusal because it can say "I cannot tell" in
# its own output vocabulary, which LiNGAM and RESIT cannot.
query I
SELECT string_agg(source || edge || target, ' ' ORDER BY source, target)
FROM do_discover('gaussian_world', algorithm := 'rcd', bootstrap := 0) WHERE in_graph;
----
xo-oy xo-oz yo-oz

query I
SELECT count(*) FROM (
  SELECT DISTINCT unnest(warnings) AS w
  FROM do_discover('gaussian_world', algorithm := 'rcd', bootstrap := 0)
) WHERE w LIKE '%RCD needs no refusal of its own%'
   OR w LIKE '%had a hidden common cause and are written <->%';
----
2

# --- the rest of the contract ------------------------------------------------------

# Resampling does not depend on the thread budget.
statement ok
CREATE TABLE one_thread AS SELECT source, target, edge, stability
FROM do_discover('confounded', algorithm := 'rcd', bootstrap := 8);

statement ok
SET threads = 1;

query I
SELECT count(*) FROM (
  SELECT source, target, edge, stability
  FROM do_discover('confounded', algorithm := 'rcd', bootstrap := 8)
  EXCEPT SELECT * FROM one_thread);
----
0

statement ok
RESET threads;

# Tiers reach it: a tier that agrees with the data settles the pair as usual.
query I
SELECT string_agg(source || edge || target, ' ' ORDER BY source, target)
FROM do_discover('clean', columns := ['c','d'], algorithm := 'rcd',
                 tiers := [['c'],['d']], bootstrap := 0)
WHERE in_graph;
----
c-->d

# A tier that contradicts the data does not quietly win here, and that is worth
# knowing. The truth is c -> d; told that c cannot cause d, RCD finds that neither
# allowed direction leaves an independent residual and reports a hidden common
# cause. That is the honest reading of its own question - no unconfounded model
# fits what you have told me - and a <-> appearing only after a tier was added is
# a sign the tier is wrong.
query I
SELECT string_agg(source || edge || target, ' ' ORDER BY source, target)
FROM do_discover('clean', columns := ['c','d'], algorithm := 'rcd',
                 tiers := [['d'],['c']], bootstrap := 0)
WHERE in_graph;
----
c<->d

statement error
SELECT * FROM do_discover('clean', algorithm := 'rcd', test := 'kernel');
----
regresses linearly and tests independence with kernels already

statement error
SELECT * FROM do_discover('clean', algorithm := 'rcd', min_effect := 0.2);
----
RESIT and RCD have no coefficients to threshold
