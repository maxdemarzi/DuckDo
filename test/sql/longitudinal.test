# name: test/sql/longitudinal.test
# description: marginal structural models for treatment that varies over time
# group: [duckdo]

require duckdo

statement ok
SELECT setseed(0.17);

# Robins' setup, and the reason marginal structural models exist. L is a
# time-varying confounder that the treatment itself affects:
#
#   L1 ~ N(0,1);  A1 ~ Bern(sigmoid(1.2*L1))
#   L2 = 0.8*L1 - 1.5*A1 + e          <-- affected by prior treatment
#   A2 ~ Bern(sigmoid(1.2*L2))
#   Y  = 3.5*A1 + 2.0*A2 + 1.0*(L1+L2) + e
#
# A1's coefficient is 3.5, but 1.5 of it is cancelled along A1 -> L2 -> Y, so
# A1's TOTAL effect is 2.0 - the same as A2's. True effect per treated period
# is therefore exactly 2.0, and no covariate list recovers it: leave L2 out and
# it confounds A2, put L2 in and it blocks part of A1.
statement ok
CREATE TABLE wide AS
WITH u AS (
  SELECT i,
    sqrt(-2*ln(random()+1e-12))*cos(2*pi()*random()) AS l1,
    random() AS u1, random() AS u2,
    sqrt(-2*ln(random()+1e-12))*cos(2*pi()*random()) AS e2,
    sqrt(-2*ln(random()+1e-12))*cos(2*pi()*random()) AS ey
  FROM range(20000) t(i)),
 s1 AS (SELECT *, (u1 < 1.0/(1.0+exp(-1.2*l1)))::INT AS a1 FROM u),
 s2 AS (SELECT *, 0.8*l1 - 1.5*a1 + e2 AS l2 FROM s1),
 s3 AS (SELECT *, (u2 < 1.0/(1.0+exp(-1.2*l2)))::INT AS a2 FROM s2)
SELECT i AS id, l1, a1, l2, a2, 3.5*a1 + 2.0*a2 + 1.0*(l1+l2) + ey AS y FROM s3;

statement ok
CREATE TABLE longdata AS
SELECT id, 1 AS period, l1 AS l, a1 AS a, NULL::DOUBLE AS y FROM wide
UNION ALL
SELECT id, 2 AS period, l2 AS l, a2 AS a, y FROM wide;

# Not adjusting is confounded, well above the truth of 2.0.
query I
SELECT regr_slope(y, a1+a2) > 3.5 FROM wide;
----
true

# Adjusting for every measured confounder - the obvious thing to do - recovers
# the structural coefficient 3.5 rather than the causal effect 2.0. This is the
# failure the whole method exists to fix, so it is asserted rather than assumed.
query I
SELECT abs(estimate - 3.5) < 0.15
FROM do_ate('wide', treatment := 'a1', outcome := 'y', covariates := ['l1', 'l2']);
----
true

# Reweighting instead of adjusting recovers it.
query II
SELECT abs(estimate - 2.0) < 0.25, ci_low < 2.0 AND 2.0 < ci_high
FROM do_msm('longdata', unit := 'id', period := 'period', treatment := 'a', outcome := 'y',
            covariates := ['l']);
----
true	true

query II
SELECT estimand, estimator
FROM do_msm('longdata', unit := 'id', period := 'period', treatment := 'a', outcome := 'y',
            covariates := ['l']);
----
effect per treated period	msm-iptw

# The mean stabilised weight is the cheapest check on the weight model, so it is
# in the result. Near 1 is what a well-specified model looks like.
query I
SELECT abs(mean_weight - 1.0) < 0.05
FROM do_msm('longdata', unit := 'id', period := 'period', treatment := 'a', outcome := 'y',
            covariates := ['l']);
----
true

# The weights are heavy-tailed here, and saying so is the point of reporting
# them: effective n is well below the unit count.
query I
SELECT effective_n < n_units
FROM do_msm('longdata', unit := 'id', period := 'period', treatment := 'a', outcome := 'y',
            covariates := ['l']);
----
true

# --- truncation is a trap, and the numbers say so ------------------------------
#
# Truncating the weights nearly doubles the effective sample size and cuts the
# interval by more than half. It also moves the estimate from 2.13 - which
# covers the truth - to 2.51, which does not. Everything that looks like a
# quality signal improves while the answer gets worse, so truncation is off by
# default and the result carries a warning when it is used.

query I
SELECT effective_n > (SELECT effective_n FROM do_msm('longdata', unit := 'id', period := 'period',
                                                     treatment := 'a', outcome := 'y', covariates := ['l']))
FROM do_msm('longdata', unit := 'id', period := 'period', treatment := 'a', outcome := 'y',
            covariates := ['l'], truncate := 0.01);
----
true

query I
SELECT ci_low < 2.0 AND 2.0 < ci_high
FROM do_msm('longdata', unit := 'id', period := 'period', treatment := 'a', outcome := 'y',
            covariates := ['l'], truncate := 0.01);
----
false

query I
SELECT len(list_filter(warnings, lambda w: w LIKE '%trades variance for bias%')) = 1
FROM do_msm('longdata', unit := 'id', period := 'period', treatment := 'a', outcome := 'y',
            covariates := ['l'], truncate := 0.01);
----
true

# Without truncation the result points at it rather than staying silent about a
# heavy tail.
query I
SELECT len(list_filter(warnings, lambda w: w LIKE '%truncate := 0.01 would clamp%')) = 1
FROM do_msm('longdata', unit := 'id', period := 'period', treatment := 'a', outcome := 'y',
            covariates := ['l']);
----
true

# --- the assumption it does not buy --------------------------------------------

query I
SELECT len(list_filter(warnings, lambda w: w LIKE '%buys nothing against unmeasured confounding%')) = 1
FROM do_msm('longdata', unit := 'id', period := 'period', treatment := 'a', outcome := 'y',
            covariates := ['l']);
----
true

# Omitting covariates entirely is legal but says what it really is.
query I
SELECT len(list_filter(warnings, lambda w: w LIKE '%unadjusted estimate wearing a marginal structural model%')) = 1
FROM do_msm('longdata', unit := 'id', period := 'period', treatment := 'a', outcome := 'y');
----
true

# --- when treatment happened -----------------------------------------------------
#
# model := 'by_period' gives each period its own effect in the same
# pseudo-population. Here each period's total effect is 2.0 (A1's 3.5, less the
# 1.5 it cancels through L2), so both come out near 2.0, and always treated
# against never near 4.0.
query III
SELECT estimand,
       abs(estimate - CASE WHEN estimand LIKE 'always%' THEN 4.0 ELSE 2.0 END) < 0.35,
       ci_low < CASE WHEN estimand LIKE 'always%' THEN 4.0 ELSE 2.0 END
         AND CASE WHEN estimand LIKE 'always%' THEN 4.0 ELSE 2.0 END < ci_high
FROM do_msm('longdata', unit := 'id', period := 'period', treatment := 'a', outcome := 'y',
            covariates := ['l'], model := 'by_period')
ORDER BY estimand;
----
always vs never treated	true	true
effect of treatment in period 1	true	true
effect of treatment in period 2	true	true

# Make the second period worth 1.0 instead. By period, the effects are 2.0 and
# 1.0 and their sum 3.0. The cumulative model fits one number per treated period,
# and its interval covers neither.
statement ok
CREATE TABLE timing AS
SELECT id, 1 AS period, l1 AS l, a1 AS a, NULL::DOUBLE AS y FROM wide
UNION ALL
SELECT id, 2 AS period, l2 AS l, a2 AS a, y - a2 AS y FROM wide;

query III
SELECT estimand,
       abs(estimate - CASE estimand WHEN 'effect of treatment in period 1' THEN 2.0
                                    WHEN 'effect of treatment in period 2' THEN 1.0 ELSE 3.0 END) < 0.35,
       ci_low < CASE estimand WHEN 'effect of treatment in period 1' THEN 2.0
                              WHEN 'effect of treatment in period 2' THEN 1.0 ELSE 3.0 END
         AND CASE estimand WHEN 'effect of treatment in period 1' THEN 2.0
                           WHEN 'effect of treatment in period 2' THEN 1.0 ELSE 3.0 END < ci_high
FROM do_msm('timing', unit := 'id', period := 'period', treatment := 'a', outcome := 'y',
            covariates := ['l'], model := 'by_period')
ORDER BY estimand;
----
always vs never treated	true	true
effect of treatment in period 1	true	true
effect of treatment in period 2	true	true

query I
SELECT NOT (ci_low < 2.0 AND 2.0 < ci_high) AND NOT (ci_low < 1.0 AND 1.0 < ci_high)
FROM do_msm('timing', unit := 'id', period := 'period', treatment := 'a', outcome := 'y', covariates := ['l']);
----
true

query I
SELECT len(list_filter(warnings, lambda w: w LIKE '%gives each period its own effect%')) = 1
FROM do_msm('longdata', unit := 'id', period := 'period', treatment := 'a', outcome := 'y',
            covariates := ['l'], model := 'by_period')
LIMIT 1;
----
true

statement error
SELECT * FROM do_msm('longdata', unit := 'id', period := 'period', treatment := 'a', outcome := 'y',
                     covariates := ['l'], model := 'quadratic');
----
model must be 'cumulative', 'by_period' or 'saturated'

# model := 'saturated' gives every treatment history its own mean. Where the
# periods simply add, it agrees with by_period.
query II
SELECT estimand, abs(estimate - CASE WHEN estimand LIKE 'treated in every%' THEN 4.0 ELSE 2.0 END) < 0.35
FROM do_msm('longdata', unit := 'id', period := 'period', treatment := 'a', outcome := 'y',
            covariates := ['l'], model := 'saturated')
ORDER BY estimand;
----
treated in every period vs never treated	true
treated in period 1 only vs never treated	true
treated in period 2 only vs never treated	true

# Add an interaction worth 1.5 when both periods are treated. Both periods are
# then worth 5.5 together, and period 1 alone still 2.0. by_period assumes the
# periods add, and reports an effect of period 1 whose interval excludes 2.0: a
# number that describes no regime anyone could follow. saturated recovers both.
statement ok
CREATE TABLE interaction AS
SELECT id, 1 AS period, l1 AS l, a1 AS a, NULL::DOUBLE AS y FROM wide
UNION ALL
SELECT id, 2 AS period, l2 AS l, a2 AS a, y + 1.5 * a1 * a2 AS y FROM wide;

query II
SELECT estimand, abs(estimate - CASE WHEN estimand LIKE 'treated in every%' THEN 5.5 ELSE 2.0 END) < 0.35
FROM do_msm('interaction', unit := 'id', period := 'period', treatment := 'a', outcome := 'y',
            covariates := ['l'], model := 'saturated')
ORDER BY estimand;
----
treated in every period vs never treated	true
treated in period 1 only vs never treated	true
treated in period 2 only vs never treated	true

query I
SELECT NOT (ci_low < 2.0 AND 2.0 < ci_high)
FROM do_msm('interaction', unit := 'id', period := 'period', treatment := 'a', outcome := 'y',
            covariates := ['l'], model := 'by_period')
WHERE estimand = 'effect of treatment in period 1';
----
true

query I
SELECT len(list_filter(warnings, lambda w: w LIKE '%gives every treatment history its own mean%')) = 1
FROM do_msm('longdata', unit := 'id', period := 'period', treatment := 'a', outcome := 'y',
            covariates := ['l'], model := 'saturated')
LIMIT 1;
----
true

# The interval treats the weights as known. With weights this heavy that makes it
# too narrow, not conservative, and the warning says so.
query I
SELECT len(list_filter(warnings, lambda w: w LIKE 'the interval treats the weights as known. When the weights are heavy it is too narrow%')) = 1
FROM do_msm('longdata', unit := 'id', period := 'period', treatment := 'a', outcome := 'y', covariates := ['l']);
----
true

# Seven periods have 128 histories, too many to give each its own mean.
statement ok
CREATE TABLE seven AS
SELECT i AS id, p AS period, random() AS l, (random() < 0.5)::INT AS a,
       CASE WHEN p = 7 THEN random() END AS y
FROM range(40) r(i), range(1, 8) q(p);

statement error
SELECT * FROM do_msm('seven', unit := 'id', period := 'period', treatment := 'a', outcome := 'y',
                     covariates := ['l'], model := 'saturated');
----
use model := 'by_period'

# Without a never-treated unit there is nothing to compare the histories with.
statement ok
CREATE TABLE treated_first AS
SELECT id, period, l, CASE WHEN period = 1 THEN 1 ELSE a END AS a, y FROM longdata;

statement error
SELECT * FROM do_msm('treated_first', unit := 'id', period := 'period', treatment := 'a', outcome := 'y',
                     covariates := ['l'], model := 'saturated');
----
no never-treated history

# A unit seen in only one of the periods has no treatment to give the other.
statement ok
CREATE TABLE unbalanced AS SELECT * FROM longdata WHERE NOT (period = 1 AND id < 5);

statement error
SELECT * FROM do_msm('unbalanced', unit := 'id', period := 'period', treatment := 'a', outcome := 'y',
                     covariates := ['l'], model := 'by_period');
----
needs every unit observed once in every period

# --- error paths ----------------------------------------------------------------

statement error
SELECT * FROM do_msm('longdata', period := 'period', treatment := 'a', outcome := 'y');
----
requires unit

statement error
SELECT * FROM do_msm('longdata', unit := 'id', treatment := 'a', outcome := 'y');
----
requires period

statement error
SELECT * FROM do_msm('longdata', unit := 'id', period := 'period', outcome := 'y');
----
requires treatment

statement error
SELECT * FROM do_msm('longdata', unit := 'id', period := 'period', treatment := 'a');
----
requires outcome

statement error
SELECT * FROM do_msm('longdata', unit := 'id', period := 'period', treatment := 'a', outcome := 'y',
                     covariates := ['l'], truncate := 0.7);
----
truncate := must be in [0, 0.5)

# The numerator and denominator models have to be nested, so a baseline
# covariate that is not also in covariates := is refused rather than silently
# producing weights that do not stabilise.
statement error
SELECT * FROM do_msm('longdata', unit := 'id', period := 'period', treatment := 'a', outcome := 'y',
                     covariates := ['l'], baseline := ['not_listed']);
----
must also appear in covariates

statement ok
CREATE TABLE oneperiod AS SELECT id, 1 AS period, l1 AS l, a1 AS a, y FROM wide;

statement error
SELECT * FROM do_msm('oneperiod', unit := 'id', period := 'period', treatment := 'a', outcome := 'y',
                     covariates := ['l']);
----
needs at least two periods

statement ok
CREATE TABLE tinypanel AS SELECT * FROM longdata WHERE id < 10;

statement error
SELECT * FROM do_msm('tinypanel', unit := 'id', period := 'period', treatment := 'a', outcome := 'y',
                     covariates := ['l']);
----
needs at least twenty units

# Every unit treated in both periods: no dose to respond to.
statement ok
CREATE TABLE constant_dose AS SELECT id, period, l, 1 AS a, y FROM longdata;

statement error
SELECT * FROM do_msm('constant_dose', unit := 'id', period := 'period', treatment := 'a', outcome := 'y',
                     covariates := ['l']);
----
no dose-response is estimable

# Both names are registered.
query I
SELECT count(*) FROM duckdo_msm('longdata', unit := 'id', period := 'period', treatment := 'a',
                                outcome := 'y', covariates := ['l']);
----
1
