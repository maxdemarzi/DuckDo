# name: test/sql/duckdo.test
# description: extension loads and reports actionable errors
# group: [duckdo]

statement error
SELECT * FROM do_ate('customers', treatment := 'discount', outcome := 'revenue');
----
Catalog Error

require duckdo

statement ok
CREATE TABLE tiny AS SELECT i AS id, (i % 2) AS t, i * 1.0 AS y, (i % 7) * 1.0 AS x FROM range(400) r(i);

# Both the short and the full name are registered.
query I
SELECT count(*) FROM do_ate('tiny', treatment := 't', outcome := 'y', covariates := ['x']);
----
1

query I
SELECT count(*) FROM duckdo_ate('tiny', treatment := 't', outcome := 'y', covariates := ['x']);
----
1

# A misspelled column names the available columns rather than failing opaquely.
statement error
SELECT * FROM do_ate('tiny', treatment := 'treatmnt', outcome := 'y');
----
Available columns

# A missing outcome is caught at bind time.
statement error
SELECT * FROM do_ate('tiny', treatment := 't');
----
requires outcome

# An unknown estimator lists the supported ones.
statement error
SELECT * FROM do_ate('tiny', treatment := 't', outcome := 'y', covariates := ['x'], estimator := 'magic');
----
unknown estimator

# The model surface has moved to models.test; here we only confirm that an
# unknown model id is rejected rather than silently ignored. ('causalpfn' is a
# real model now, so this uses an id that genuinely does not exist.)
statement error
SELECT * FROM do_ate('tiny', treatment := 't', outcome := 'y', model := 'gpt_causal_9000');
----
unknown model

# A non-binary treatment is refused rather than silently binarised, and the
# error points at the continuous-treatment functions.
statement error
SELECT * FROM do_ate('tiny', treatment := 'x', outcome := 'y', covariates := ['t']);
----
do_ape() or do_dose_response()

# --- guardrails -----------------------------------------------------------------
#
# Every limit is an exception that names the setting to raise, never a silent
# truncation. That is the whole contract: a wrong answer from a quietly sampled
# frame is worse than no answer.

statement ok
CREATE TABLE wide AS SELECT i AS id, (i % 2) AS t, i * 1.0 AS y,
       (i % 7) * 1.0 AS a, (i % 5) * 1.0 AS b, (i % 3) * 1.0 AS c FROM range(400) r(i);

statement ok
SET duckdo_max_rows = 100;

statement error
SELECT * FROM do_ate('wide', treatment := 't', outcome := 'y', covariates := ['a']);
----
Raise duckdo_max_rows

statement ok
RESET duckdo_max_rows;

statement ok
SET duckdo_max_features = 2;

statement error
SELECT * FROM do_ate('wide', treatment := 't', outcome := 'y', covariates := ['a', 'b', 'c']);
----
above duckdo_max_features

statement ok
RESET duckdo_max_features;

# The memory ceiling is on the encoded matrix, so it is a function of rows AND
# width. 400 rows by 3 features is 9.6 kB.
statement ok
SET duckdo_max_memory = '4KB';

statement error
SELECT * FROM do_ate('wide', treatment := 't', outcome := 'y', covariates := ['a', 'b', 'c']);
----
above duckdo_max_memory

# The message says how many rows would fit, and that number is usable as-is.
statement error
SELECT * FROM do_ate('wide', treatment := 't', outcome := 'y', covariates := ['a', 'b', 'c']);
----
about 166 rows fit at this width

# Narrower fits where wider did not, at the same ceiling.
query I
SELECT count(*) FROM do_ate('wide', treatment := 't', outcome := 'y', covariates := ['a']);
----
1

statement ok
SET duckdo_max_memory = '-1';

query I
SELECT count(*) FROM do_ate('wide', treatment := 't', outcome := 'y', covariates := ['a', 'b', 'c']);
----
1

statement ok
RESET duckdo_max_memory;

# --- an empty covariate list means none, not all --------------------------------
#
# `covariates := []` used to fall through to the same branch as omitting the
# argument, which adjusts for every remaining column. Asking for no adjustment
# and silently getting full adjustment is a wrong answer rather than a
# surprising one, so the two are now distinguishable.

statement ok
CREATE TABLE confounded AS
WITH u AS (SELECT i, sqrt(-2*ln(random()+1e-12))*cos(2*pi()*random()) AS x,
                     sqrt(-2*ln(random()+1e-12))*cos(2*pi()*random()) AS e,
                     random() AS d FROM range(8000) r(i)),
 p AS (SELECT *, 1.0/(1.0+exp(-1.5*x)) AS ps FROM u)
SELECT i AS id, x, (d<ps)::INT AS t, 2.0*x + 3.0*((d<ps)::INT) + e AS y FROM p;

# Omitted: adjusts for x, recovers the true 3.0.
query I
SELECT abs(estimate - 3.0) < 0.15
FROM do_ate('confounded', treatment := 't', outcome := 'y', exclude := ['id']);
----
true

# Explicitly empty: no adjustment at all, so the confounding is left in and the
# estimate is well above 3.0.
query I
SELECT estimate > 3.5
FROM do_ate('confounded', treatment := 't', outcome := 'y', covariates := []);
----
true

# The frame reports what it actually used, either way.
query I
SELECT n_features FROM do_frame_summary('confounded', treatment := 't', outcome := 'y',
                                        covariates := []);
----
0

# --- do_frame_summary: what the encoder actually did ----------------------------
#
# The roadmap names this as the mitigation for "encoder choices can silently bias
# estimates". Every estimator runs on this frame, so what it contains has to be
# answerable without reading the source.

statement ok
CREATE TABLE mixed AS
SELECT i AS id, (i % 2) AS t, i * 1.0 AS y,
       CASE WHEN i % 5 = 0 THEN NULL ELSE (i % 7) * 1.0 END AS tenure,
       ['red','green','blue'][(i % 3) + 1] AS colour
FROM range(400) r(i);

# A NULL-bearing numeric becomes a filled column plus an explicit indicator, and
# a categorical becomes one column per non-reference level.
query IIII
SELECT feature, source, kind, level
FROM do_frame_summary('mixed', treatment := 't', outcome := 'y', exclude := ['id'])
ORDER BY feature;
----
colour=green	colour	one_hot	green
colour=red	colour	one_hot	red
tenure	tenure	numeric	NULL
tenure__missing	tenure	missing_indicator	NULL

# Rows are never dropped for a missing covariate, and the count is reported.
query II
SELECT DISTINCT n, n_rows_with_missing
FROM do_frame_summary('mixed', treatment := 't', outcome := 'y', exclude := ['id']);
----
400	80

# The standardisation applied to each feature is visible, since it is what the
# reported coefficients are on.
query I
SELECT abs(center - 2.995) < 0.01 AND abs(scale - 1.794) < 0.01
FROM do_frame_summary('mixed', treatment := 't', outcome := 'y', exclude := ['id'])
WHERE feature = 'tenure';
----
true

query II
SELECT DISTINCT treated_label, control_label
FROM do_frame_summary('mixed', treatment := 't', outcome := 'y', exclude := ['id']);
----
1	0

# --- results do not depend on the thread budget ---------------------------------
#
# Floating-point addition is not associative, so if the row-block split follows
# the core count then so does the answer. It used to: the same query on the same
# seed gave 3.0031935719077567 on one thread and 3.0031935719077549 on sixteen.
# The block count is a function of the data now, and the blocks reduce in index
# order, so this holds to the last bit rather than to a tolerance.

statement ok
SELECT setseed(0.21);

statement ok
CREATE TABLE threaded AS
WITH u AS (SELECT i, sqrt(-2*ln(random()+1e-12))*cos(2*pi()*random()) AS x,
  sqrt(-2*ln(random()+1e-12))*cos(2*pi()*random()) AS e, random() AS d FROM range(50000) r(i)),
 p AS (SELECT *, 1.0/(1.0+exp(-0.9*x)) AS ps FROM u)
SELECT i AS id, x, (d<ps)::INT AS t, 2.0+1.5*x+3.0*((d<ps)::INT)+e AS y FROM p;

statement ok
SET duckdo_threads = 1;

statement ok
CREATE TABLE one_thread AS
SELECT estimate, std_error FROM do_ate('threaded', treatment := 't', outcome := 'y', covariates := ['x']);

statement ok
SET duckdo_threads = 8;

# Bit-identical, not merely close: an equality test on a double is the point.
query II
SELECT a.estimate = o.estimate, a.std_error = o.std_error
FROM do_ate('threaded', treatment := 't', outcome := 'y', covariates := ['x']) a, one_thread o;
----
true	true

# The same holds through a bootstrap, where each replicate seeds from (seed, rep)
# rather than from a stream whose order depends on scheduling.
statement ok
SET duckdo_threads = 1;

statement ok
CREATE TABLE one_thread_boot AS
SELECT estimate, std_error FROM do_frontdoor('threaded', treatment := 't', outcome := 'y',
                                             mediator := 'x', covariates := []);

statement ok
SET duckdo_threads = 8;

query II
SELECT abs(a.estimate - o.estimate) = 0, abs(a.std_error - o.std_error) = 0
FROM do_frontdoor('threaded', treatment := 't', outcome := 'y', mediator := 'x',
                  covariates := []) a, one_thread_boot o;
----
true	true

statement ok
RESET duckdo_threads;
