# name: test/sql/duckdo.test
# description: extension loads and reports actionable errors
# group: [duckdo]

statement error
SELECT * FROM do_ate('customers', treatment := 'discount', outcome := 'revenue');
----
Catalog Error

require duckdo

statement ok
CREATE TABLE tiny AS SELECT i AS id, (i % 2) AS t, i * 1.0 AS y, (i % 7) * 1.0 AS x FROM range(400) r(i);

# Both the short and the full name are registered.
query I
SELECT count(*) FROM do_ate('tiny', treatment := 't', outcome := 'y', covariates := ['x']);
----
1

query I
SELECT count(*) FROM duckdo_ate('tiny', treatment := 't', outcome := 'y', covariates := ['x']);
----
1

# A misspelled column names the available columns rather than failing opaquely.
statement error
SELECT * FROM do_ate('tiny', treatment := 'treatmnt', outcome := 'y');
----
Available columns

# A missing outcome is caught at bind time.
statement error
SELECT * FROM do_ate('tiny', treatment := 't');
----
requires outcome

# An unknown estimator lists the supported ones.
statement error
SELECT * FROM do_ate('tiny', treatment := 't', outcome := 'y', covariates := ['x'], estimator := 'magic');
----
unknown estimator

# Foundation models are not here yet, and the error says exactly that.
statement error
SELECT * FROM do_ate('tiny', treatment := 't', outcome := 'y', model := 'causalpfn');
----
0.6 release

# A non-binary treatment is refused rather than silently binarised.
statement error
SELECT * FROM do_ate('tiny', treatment := 'x', outcome := 'y', covariates := ['t']);
----
binary treatments only
